[Unit]
Description=LMS Systems Docker Container
Requires=docker.service
After=docker.service

[Service]
Restart=always
EnvironmentFile=/home/daniil/LMS-systems/.env
ExecStart=/usr/bin/docker run -d --network=mynetwork --name lms_systems -p 80:8000 --env-file /home/daniil/LMS-systems/.env ontarasoff/lms_systems:latest
ExecStop=/usr/bin/docker stop lms_systems

[Install]
WantedBy=multi-user.target