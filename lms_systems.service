[Unit]
Description=LMS Systems Docker Container
Requires=docker.service
After=docker.service

[Service]
Restart=always
EnvironmentFile=/home/daniil/LMS-systems/.env
ExecStart=/usr/bin/docker run -d --name lms_systems --memory="2g" --memory-swap="3g" --network=mynetwork -p 8000:8000 --env-file /home/daniil/LMS-systems/.env ontarasoff/lms_systems:latest
ExecStop=/usr/bin/docker stop lms_systems

[Install]
WantedBy=multi-user.target